{
  "name": "jore-postgres-import",
  "version": "1.0.5",
  "description": "Data importer for jore-graphql",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node -r dotenv/config src/index.js",
    "lint": "eslint src --fix",
    "format": "prettier --write \"{src,test}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"{src,test}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "lint:check": "npm run format:check",
    "lint:mega": "npx --yes mega-linter-runner@9 --flavor javascript --release v9.6.0",
    "lint:mega:fix": "npx --yes mega-linter-runner@9 --flavor javascript --release v9.6.0 --fix",
    "lint:mega:changed": "npx --yes mega-linter-runner@9 --flavor javascript --release v9.6.0 -e VALIDATE_ALL_CODEBASE=false",
    "test:unit": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info --test-reporter=junit --test-reporter-destination=junit.xml \"test/**/*.test.js\"",
    "check-and-build": "npm run lint:check && npm run test:unit",
    "ftpsource": "ftp-srv ftp://127.0.0.1:2121 --root ./source",
    "knex": "knex",
    "knex:local": "PG_CONNECTION_STRING=postgres://postgres:mysecretpassword@localhost:5678/postgres knex",
    "initdb": "node -r dotenv/config src/setup/initDb.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HSLdevcom/jore-graphql-import.git"
  },
  "keywords": [],
  "author": "Hannes Junnila <hannes.junnila@gmail.com>",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/HSLdevcom/jore-graphql-import/issues"
  },
  "homepage": "https://github.com/HSLdevcom/jore-graphql-import",
  "dependencies": {
    "@azure/storage-blob": "12.34.0",
    "@babel/core": "^7.28.0",
    "@babel/plugin-transform-flow-strip-types": "^7.22.5",
    "@babel/preset-env": "^7.22.15",
    "@babel/preset-react": "^7.22.15",
    "basic-ftp": "^5.3.1",
    "cron": "^4.3.3",
    "date-fns": "^2.30.0",
    "dotenv": "^8.0.0",
    "express": "^4.17.1",
    "express-basic-auth": "^1.2.0",
    "express-fileupload": "^1.1.5",
    "express-rate-limit": "^7.5.0",
    "express-react-views": "^0.11.0",
    "fs-extra": "^11.1.1",
    "iconv-lite": "^0.6.3",
    "knex": "^2.5.1",
    "knex-postgis": "^0.14.3",
    "lodash-es": "^4.18.1",
    "p-map": "^7.0.3",
    "p-queue": "^7.4.1",
    "pg": "^8.11.3",
    "pg-connection-string": "^2.6.2",
    "react": "^16.8.6",
    "react-dom": "^16.8.6",
    "split2": "^4.2.0",
    "unzipper": "^0.10.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@types/fs-extra": "^11.0.1",
    "eslint": "^10.9.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.37.5",
    "glob": "^14.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.0.3"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
